[Unit]
Description=Slack notification when the host shuts down or reboots (HostWatch)
Documentation=https://github.com/Big-Zee/Hostwatch
# Stopped in reverse order: the network managers and systemd-resolved are
# ordered before network.target and nss-lookup.target, so they are still up when
# ExecStop sends the message. Not network-online.target: at boot that would make
# multi-user.target wait for the network to come online.
After=network.target nss-lookup.target

[Service]
# Active from boot; the work happens in ExecStop at shutdown.
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/hostwatch shutdown
# Hard cap so shutdown is never held up for long (the HTTP timeout alone does
# not bound DNS lookups).
TimeoutStopSec=10
StateDirectory=hostwatch
SyslogIdentifier=hostwatch
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
