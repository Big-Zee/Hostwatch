[Unit]
Description=Periodic HostWatch heartbeat
Documentation=https://github.com/Big-Zee/Hostwatch

[Timer]
# Relative to when this timer starts (early in boot, or when install.sh
# restarts it), not the wall clock: first run one interval after that, then
# one interval after each run. A boot-relative trigger is not used: after a
# restart on a long-running host it is already in the past. install.sh overrides both
# values with [heartbeat] interval_minutes in a drop-in
# (hostwatch-heartbeat.timer.d/).
OnActiveSec=60min
OnUnitActiveSec=60min
AccuracySec=1min

[Install]
WantedBy=timers.target
