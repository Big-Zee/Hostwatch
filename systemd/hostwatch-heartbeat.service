[Unit]
Description=Slack heartbeat with uptime, users and top processes (HostWatch)
Documentation=https://github.com/Big-Zee/Hostwatch
Wants=network-online.target
After=network-online.target nss-lookup.target

# Started by hostwatch-heartbeat.timer; no [Install] section.
[Service]
Type=oneshot
ExecStart=/usr/local/bin/hostwatch heartbeat
TimeoutStartSec=30
Nice=10
IOSchedulingClass=idle
SyslogIdentifier=hostwatch
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Writable /var/lib/hostwatch: the heartbeat also updates the last-alive
# timestamp and reads the uptime-today ledger.
StateDirectory=hostwatch
